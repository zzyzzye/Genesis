# Genesis 本地开发 / 测试配置
# 复制为 .env.development 后填写：cp -n .env.development.example .env.development
# 启动：make docker-dev；前端 5173，后端 8000。不要用于公网生产部署。
# 实际配置不进入 Git；已有 .env 不会被新启动命令读取。

# 本地签名与示例账号；下列固定值只用于开发。
GENESIS_JWT_SECRET=development-only-jwt-secret-do-not-use-in-production
GENESIS_AGENT_ACTION_SECRET=development-only-agent-action-secret
GENESIS_DEVELOPMENT_OWNER_PASSWORD=genesis-local-only
GENESIS_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
GENESIS_JWT_REFRESH_TOKEN_EXPIRE_MINUTES=1440
GENESIS_AGENT_MAX_CONCURRENT_RUNS=4
GENESIS_DEBUG=false
GENESIS_CORS_ORIGINS=["http://localhost:5173"]

# 文本模型：openai / grok / gemini / claude / mimo
# 至少填写所选 Provider 的 API Key；模型名作为模型目录不可用时的回退。
GENESIS_TEXT_PROVIDER=openai
GENESIS_TEXT_TEMPERATURE=0.7
GENESIS_TEXT_MAX_TOKENS=4096

# YYAPI 模型价格预览：填写控制台访问令牌，不是模型调用 API Key。
# 仅用于读取令牌分组和价格；未配置时不影响模型目录展示。
GENESIS_YYAPI_ACCESS_TOKEN=
# 上游要求 New-Api-User 时填写用户 ID，否则保持 null。
GENESIS_YYAPI_USER_ID=null
GENESIS_YYAPI_CONTROL_BASE_URL=https://www.yyapi.cloud
# 默认直连；仅本地调试需要代理时填写 http://host.docker.internal:7897。
GENESIS_YYAPI_PROXY_URL=

# OpenAI 兼容网关：BASE_URL 通常包含 /v1。
GENESIS_TEXT_OPENAI_API_KEY=
GENESIS_TEXT_OPENAI_BASE_URL=https://www.yyapi.cloud/v1
GENESIS_TEXT_OPENAI_MODEL=gpt-5.6-luna

GENESIS_TEXT_GROK_API_KEY=
GENESIS_TEXT_GROK_BASE_URL=https://www.yyapi.cloud
GENESIS_TEXT_GROK_MODEL=

GENESIS_TEXT_GEMINI_API_KEY=
GENESIS_TEXT_GEMINI_BASE_URL=https://www.yyapi.cloud
GENESIS_TEXT_GEMINI_MODEL=

GENESIS_TEXT_CLAUDE_API_KEY=
GENESIS_TEXT_CLAUDE_BASE_URL=https://www.yyapi.cloud
GENESIS_TEXT_CLAUDE_MODEL=

GENESIS_TEXT_MIMO_API_KEY=
GENESIS_TEXT_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
GENESIS_TEXT_MIMO_MODEL=mimo-v2.6-flash

# 生图、生视频：API 地址不要附加 /v1。
GENESIS_IMAGE_API_KEY=
GENESIS_IMAGE_API_BASE_URL=https://zl.yyapi.cloud
GENESIS_VIDEO_API_KEY=
GENESIS_VIDEO_API_BASE_URL=https://zl.yyapi.cloud
# 本地没有公网素材入口时留空；不影响文生视频。
GENESIS_VIDEO_PUBLIC_BASE_URL=
