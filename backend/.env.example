# 仅在脱离 Docker 本地运行后端时需要。不要提交真实的 .env 文件。
GENESIS_DATABASE_HOST=localhost
GENESIS_DATABASE_PORT=5432
GENESIS_DATABASE_NAME=genesis
GENESIS_DATABASE_USER=genesis
GENESIS_DATABASE_PASSWORD=请替换为仅本地使用的数据库密码

# 文本生成模型
# 可选值：openai、grok、claude
GENESIS_TEXT_PROVIDER=openai

# OpenAI / GPT
GENESIS_TEXT_OPENAI_API_KEY=
GENESIS_TEXT_OPENAI_BASE_URL=https://api.openai.com/v1
GENESIS_TEXT_OPENAI_MODEL=

# xAI / Grok
GENESIS_TEXT_GROK_API_KEY=
GENESIS_TEXT_GROK_BASE_URL=https://api.x.ai/v1
GENESIS_TEXT_GROK_MODEL=

# Anthropic / Claude
GENESIS_TEXT_CLAUDE_API_KEY=
GENESIS_TEXT_CLAUDE_BASE_URL=https://api.anthropic.com
GENESIS_TEXT_CLAUDE_MODEL=

# 文本生成通用参数
GENESIS_TEXT_TEMPERATURE=0.7
GENESIS_TEXT_MAX_TOKENS=4096

# LangGraph 独立 Agent（仅后端访问）
GENESIS_AGENT_URL=http://agent:8123
GENESIS_AGENT_INTERNAL_TOKEN=development-only-agent-token
